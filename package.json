{
  "name": "nexus-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "node --test server/*.test.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/*.mjs\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
